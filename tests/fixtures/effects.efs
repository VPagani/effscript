// Effect-specific syntax.
import { Data } from "effect";

export error NotFound { id: string }
export error Timeout

service Clock("app/Clock") {
  now: Effect<number>;
  readonly sleep: (ms: number) => Effect<void>;
}

service Cache {
  get(key: string): Effect<string, NotFound>;
  set(key: string, value: string): Effect<void>;
}

layer ClockLive for Clock = {
  now: Effect.sync(() => Date.now()),
  sleep: (ms) => Effect.sleep(ms),
};

layer CacheLive for Cache {
  const store = new Map<string, string>();
  const _clock = use Clock;
  defer Console.log("cache closed");
  return {
    effect get(key: string) {
      const value = store.get(key);
      if value == undefined {
        fail new NotFound({ id: key });
      }
      return value;
    },
    set: (key, value) => Effect.sync(() => {
      store.set(key, value);
    }),
  };
}

export effect function lookup(key: string): Effect<string, NotFound, Cache> {
  const cache = use Cache;
  return run cache.get(key);
}

export const resilient = lookup("a")
  |> Effect.retry(Schedule.exponential("10 millis"))
  |> Effect.timeout("1 second")
  catch {
    NotFound(e) => Effect.succeed(`missing ${e.id}`)
    TimeoutError => Effect.succeed("slow")
  };

export const recovered = lookup("b") catch e => Effect.succeed(String(e));

export const anonymous = effect (n: number) => {
  run Effect.log(n);
  return n * 2;
};

export const total = effect {
  const a = run Effect.succeed(1);
  const b = (run Effect.succeed(2)) + a;
  for run n of Stream.range(1, 3) {
    run Console.log(n + b);
  }
  return a + b;
};

export const provided = lookup("c")
  with Layer.provide(CacheLive, ClockLive);

Effect.runFork(total);

export const traced = effect function (n: number) {
  return run Effect.succeed(n);
};

export const doubled = effect (n: number) => run Effect.succeed(n * 2);

// Outside effect bodies `run` is an ordinary name.
function run(task: string): string {
  return `ran ${task}`;
}

export const ran = run("build");

// `use` is a keyword only before a name, so it can be an ordinary name too.
const use = (n: number): number => n + 1;

export const usedTwice = effect {
  return use(use(1));
};

export const sumBoth = effect {
  const a = run doubled(1);
  const b = (run traced(2)) + a;
  for run tick of Stream.make(a, b) {
    run Console.log(tick);
  }
  return b;
};

// Local bindings shadow prelude names where they are in scope; `Clock` above is declared here.
export const backoff = (Schedule: number): number => Schedule * 2;

export const shadowed = effect {
  const Console = { log: (message: string) => Effect.log(message) };
  run Console.log("shadowed");
};
