{
  "name": "effscript",
  "version": "0.1.0",
  "description": "EffScript: a readable syntax for Effect. Compiler, formatter, linter, language server and TypeScript content mapper.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VPagani/effscript"
  },
  "bin": {
    "efs": "bin/efs.js"
  },
  "files": [
    "bin"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "./bin/efs.js",
        "mapper"
      ]
    }
  }
}
