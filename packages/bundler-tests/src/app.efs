import { greeting } from "./greeting.efs";

error Empty

service Audience {
  names: readonly string[];
}

const AudienceLive = Layer.succeed(Audience, {
  names: ["bundlers", "plugins"],
});

export effect function greet() {
  const audience = use Audience;
  const names = audience.names;
  if names.length == 0 {
    fail new Empty();
  }
  run Console.log(greeting(names.join(" and "), names.length));
}

export const program = greet() with AudienceLive;
