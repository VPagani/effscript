// The playground's icons, from Lucide (ISC license), drawn with `currentColor`.
import { Html } from "@effect/ui/html";

const icon = <M>(h: Html.H<M>, paths: string[], size = "h-4 w-4") =>
  <svg
    viewBox="0 0 24 24"
    class={size}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {paths.map((d) => <path d={d} />)}
  </svg>;

export const playIcon = <M>(h: Html.H<M>) => icon(h, ["M6 4l14 8-14 8z"]);

export const stopIcon = <M>(h: Html.H<M>) => icon(h, ["M6 6h12v12H6z"]);

export const formatIcon = <M>(h: Html.H<M>) => icon(h, ["M21 6H3", "M15 12H3", "M17 18H3"]);

export const shareIcon = <M>(h: Html.H<M>) =>
  icon(h, ["M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71", "M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"]);

export const settingsIcon = <M>(h: Html.H<M>) =>
  icon(h, [
    "M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z",
    "M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z",
  ]);

export const trashIcon = <M>(h: Html.H<M>) =>
  icon(h, ["M3 6h18", "M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6", "M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"], "h-3.5 w-3.5");

export const reloadIcon = <M>(h: Html.H<M>) =>
  icon(h, ["M21 12a9 9 0 1 1-3-6.7L21 8", "M21 3v5h-5"], "h-3.5 w-3.5");

export const checkIcon = <M>(h: Html.H<M>) => icon(h, ["M20 6 9 17l-5-5"], "h-5 w-5");

export const terminalIcon = <M>(h: Html.H<M>) => icon(h, ["m4 17 6-6-6-6", "M12 19h8"], "h-5 w-5");

export const componentIcon = <M>(h: Html.H<M>) =>
  icon(h, ["M3 3h7v7H3z", "M14 3h7v7h-7z", "M14 14h7v7h-7z", "M3 14h7v7H3z"], "h-5 w-5");

export const spinner = <M>(h: Html.H<M>) =>
  <svg viewBox="0 0 24 24" class="h-4 w-4 animate-spin" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="3" />
    <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>;
