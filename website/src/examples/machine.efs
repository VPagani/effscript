// A statechart with @typeonce/effect-machine. Every transition is logged:
// the light turns itself off one second after it was turned on.
import { Machine } from "@typeonce/effect-machine";

export machine Light {
  events {
    Flip
  }

  initial state Off {
    on Flip -> On;
  }
  state On {
    on Flip -> Off;
    after "1 second" -> Off;
  }
}

export const main = effect {
  const light = run Machine.start(Light);
  const started = run Clock.currentTimeMillis;
  run light.changes
    |> Stream.runForEach(({ state }) => effect {
      const now = run Clock.currentTimeMillis;
      run Console.log(`${((now - started) / 1000).toFixed(1)}s  ${state.state.path}`);
    })
    |> Effect.forkScoped;
  const flip = light.send(LightEvents.Flip()) |> Effect.delay("300 millis");
  run flip;
  run flip;
  run flip;
  run Effect.sleep("1500 millis");
} |> Effect.scoped;
