// A Web Worker that runs a compiled playground program and reports its console output.
import * as effect from "effect";
import * as machine from "@typeonce/effect-machine";
import { evaluate, levels, show } from "./lib/sandbox.efs";
import type { Level } from "./lib/sandbox.efs";

type Report = { type: "line", level: Level, text: string } | { type: "done", ok: boolean };

const scope = self as unknown as {
  postMessage(report: Report): void
  onmessage: ((event: { data: { code: string } }) => void) | null
};

const print = (level: Level, text: string) => scope.postMessage({ type: "line", level, text });

for level of levels {
  console[level] = (...args: unknown[]) => print(level, args.map(show).join(" "));
}

const modules = { "effect": effect, "@typeonce/effect-machine": machine };

const finish = (ok: boolean) => scope.postMessage({ type: "done", ok });

const execute = (code: string) => {
  const evaluated = evaluate(code, modules);
  if evaluated.type == "unsupported" {
    print(
      "warn",
      `The playground runs programs that import \`effect\` and \`@typeonce/effect-machine\`; this one imports \`${evaluated.specifier}\`.`,
    );
    finish(false);
    return;
  }
  const main = evaluated.exports["main"];
  if main == undefined {
    print("warn", "Nothing to run: export a `main` effect, or a component to see it in the Preview tab.");
    finish(true);
  } else if Effect.isEffect(main) {
    Effect.runPromiseExit(main as Effect<unknown, unknown>).then((exit) => {
      if Exit.isSuccess(exit) {
        if exit.value != undefined {
          print("info", `main succeeded with ${show(exit.value)}`);
        }
        finish(true);
      } else {
        print("error", Cause.pretty(exit.cause));
        finish(false);
      }
    });
  } else {
    print("info", show(main));
    finish(true);
  }
};

scope.onmessage = (event) =>
  Effect.try({ try: () => execute(event.data.code), catch: (cause) => cause })
    |> Effect.catch((cause) =>
      Effect.sync(() => {
        print("error", show(cause));
        finish(false);
      }))
    |> Effect.runSync;
