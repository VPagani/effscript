// The EffScript compiler, running as WebAssembly.
import { init } from "@effscript/compiler/browser";
import type { Compiler, Diagnostic as CompilerDiagnostic } from "@effscript/compiler/browser";
import { Subscription } from "@effect/ui";

export type Diagnostic = CompilerDiagnostic;

let loaded: Compiler | undefined = undefined;

const ready = init().then((c) => {
  loaded = c;
  return c;
});

/** A subscription that sends `message` once the compiler has loaded. */
export const whenLoaded = <M>(message: M) =>
  Subscription.make("LoadCompiler", Stream.fromEffect(Effect.promise(() => ready)) |> Stream.map(() => message));

export const isLoaded = (): boolean => loaded != undefined;

export type Output = { ts: string, js: string, diagnostics: Diagnostic[] };

const empty: Output = { ts: "", js: "", diagnostics: [] };

let last = { key: "", output: empty };

/**
 * Compiles `source` to TypeScript and JavaScript, with the lint warnings; empty until the
 * compiler has loaded. The last result is cached, so views can call it on every render.
 */
export const compile = (source: string, prelude = true): Output => {
  if loaded == undefined {
    return empty;
  }
  const key = `${prelude}\u0000${source}`;
  if last.key == key && last.output != empty {
    return last.output;
  }
  const ts = loaded.compile(source, { target: "ts", sourceMap: false, prelude });
  const js = loaded.compile(source, { target: "js", sourceMap: false, prelude });
  const lint = loaded.lint(source);
  const output = { ts: ts.code, js: js.code, diagnostics: [...ts.diagnostics, ...lint.diagnostics] };
  last = { key, output };
  return output;
};

export const hasErrors = (output: Output): boolean => output.diagnostics.some((d) => d.severity == "error");

const componentExport = new RegExp("^export const [\\w$]+ = Html\\.component\\(", "m");

/** Whether the compiled module exports an Effect UI component, which the Preview tab renders. */
export const exportsComponent = (output: Output): boolean => componentExport.test(output.js);

/** Formats `source`, or returns it unchanged when it does not parse. */
export const format = (source: string, semicolons = true): string =>
  loaded?.format(source, { semicolons }).code ?? source;
