// A documentation page's Markdown, as styled markup: anchored headings, highlighted code
// with a "Try it" link to the playground, tables that scroll and links that stay on the site.
import { View } from "@effect/ui";
import { Html, Markdown } from "@effect/ui/html";
import { codeLines } from "./code.efs";
import type { Lang } from "./highlight.efs";
import { encode } from "./share.efs";
import { isExternal, outline, plainText, resolveLink, slugify } from "./docs.efs";
import type { Doc } from "./docs.efs";

const languages: Record<string, Lang> = {
  efs: "efs",
  ts: "ts",
  typescript: "ts",
  js: "js",
  javascript: "js",
  bash: "bash",
  sh: "bash",
  shell: "bash",
  json: "json",
};

const languageNames: Record<string, string> = {
  efs: "EffScript",
  ts: "TypeScript",
  js: "JavaScript",
  bash: "Terminal",
  json: "JSON",
};

const codeBlock = <M>(h: Html.H<M>, language: string | undefined, value: string) => {
  const lang = language == undefined ? undefined : languages[language];
  return <div class="my-6 overflow-hidden rounded-xl border border-white/10 bg-[#0d1117]">
    <div class="flex h-10 items-center gap-2 border-b border-white/10 px-4 text-xs">
      <span class="font-medium text-zinc-400">{lang == undefined ? language ?? "Text" : languageNames[lang]}</span>
      {lang == "efs" ? <a
        href={`/playground#code=${encode(value)}`}
        class="ml-auto inline-flex items-center gap-1.5 rounded-md bg-violet-500/15 px-2.5 py-1 font-medium text-violet-200 transition hover:bg-violet-500/25 hover:text-white"
      >
        <svg viewBox="0 0 16 16" class="h-3 w-3" fill="currentColor" aria-hidden="true">
          <path d="M4 2.5v11a.5.5 0 0 0 .76.43l9-5.5a.5.5 0 0 0 0-.86l-9-5.5A.5.5 0 0 0 4 2.5Z" />
        </svg>
        Try it
      </a> : null}
    </div>
    <pre class="overflow-x-auto py-4 pl-5 font-mono text-[13px] leading-6 text-[#e6edf3]">
      <code>
        {lang == undefined ? value.split("\n").map((line) => <span class="block min-h-6 pr-4">{line}</span>) : codeLines(h, value, lang)}
      </code>
    </pre>
  </div>;
};

const headingLink = "rounded-sm text-inherit no-underline";

/** Code in a heading reads as part of it. */
const headingCode = "[&_code]:bg-transparent [&_code]:px-0 [&_code]:text-[0.92em] [&_code]:text-inherit";

const h1 = `text-3xl font-bold tracking-tight text-white sm:text-4xl ${headingCode}`;

/** A section's heading, with a rule above it unless it follows the title. */
const h2 = `group mt-14 scroll-mt-24 border-t border-white/5 pt-8 text-2xl font-semibold tracking-tight text-white [:is(h1,details)+&]:mt-10 [:is(h1,details)+&]:border-t-0 [:is(h1,details)+&]:pt-0 ${headingCode}`;

const h3 = `group mt-10 scroll-mt-24 text-lg font-semibold text-white ${headingCode}`;

const h4 = `group mt-8 scroll-mt-24 font-semibold text-zinc-100 ${headingCode}`;

const anchorMark = "ml-2 text-zinc-600 opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100";

/** The blocks of a documentation page; `afterTitle` goes after its first heading. */
export const prose = <M>(h: Html.H<M>, d: Doc, afterTitle: View.Content<M> | null) => {
  const { ids } = outline(d);
  const blocks = Markdown.viewBlocks(h, d.document, {
    views: {
      Heading: (h, heading, content) => {
        const id = ids.get(heading) ?? slugify(plainText(heading.content));
        const link = [<a href={`#${id}`} class={headingLink}>{content}</a>, <span aria-hidden="true" class={anchorMark}>#</span>];
        if heading.level == 1 {
          return <h1 id={id} class={h1}>{content}</h1>;
        }
        if heading.level == 2 {
          return <h2 id={id} class={h2}>{link}</h2>;
        }
        if heading.level == 3 {
          return <h3 id={id} class={h3}>{link}</h3>;
        }
        return <h4 id={id} class={h4}>{link}</h4>;
      },
      Paragraph: (h, _paragraph, content) => <p class="my-5 leading-7 text-zinc-300">{content}</p>,
      Text: (_h, { value }) => value,
      Strong: (h, _strong, content) => <strong class="font-semibold text-zinc-100">{content}</strong>,
      Emphasis: (h, _emphasis, content) => <em class="text-zinc-200">{content}</em>,
      InlineCode: (h, { value }) =>
        <code class="rounded-md bg-white/[0.08] px-1.5 py-0.5 font-mono text-[0.85em] text-zinc-100 [box-decoration-break:clone]">{value}</code>,
      Link: (h, { url }, content) => {
        const href = resolveLink(url);
        const style = "font-medium text-violet-300 underline decoration-violet-300/30 underline-offset-4 transition hover:text-violet-200 hover:decoration-violet-200";
        return <a href={href} rel={isExternal(href) ? "noreferrer" : undefined} class={style}>{content}</a>;
      },
      CodeBlock: (h, { language, value }) => codeBlock(h, Option.getOrUndefined(language), value),
      List: (h, { isOrdered, startNumber }, items) =>
        isOrdered ? <ol
          start={Option.getOrUndefined(Option.map(startNumber, String))}
          class="my-5 list-decimal space-y-2 pl-6 text-zinc-300 marker:text-zinc-500"
        >
          {items}
        </ol> : <ul class="my-5 list-disc space-y-2 pl-6 text-zinc-300 marker:text-zinc-600">{items}</ul>,
      ListItem: (h, _item, blocks) => <li class="pl-1 leading-7 [&>p]:my-2 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">{blocks}</li>,
      Blockquote: (h, _quote, blocks) =>
        <blockquote class="my-6 border-l-2 border-violet-400/50 bg-violet-500/[0.04] py-1 pl-5 text-zinc-400">{blocks}</blockquote>,
      ThematicBreak: (h) => <hr class="my-12 border-white/10" />,
      Table: (h, _table, header, rows) =>
        <div class="my-6 overflow-x-auto rounded-xl border border-white/10 [&_td:first-child_code]:whitespace-nowrap">
          <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
            <thead class="bg-white/[0.04]">{header}</thead>
            <tbody>{rows}</tbody>
          </table>
        </div>,
      TableRow: (h, _row, cells) => <tr class="border-t border-white/5 first:border-t-0">{cells}</tr>,
      TableCell: (h, _cell, content, alignment, isHeader) => {
        const align = alignment == "Center" ? "text-center" : alignment == "Right" ? "text-right" : "text-left";
        if isHeader {
          return <th class={["px-4 py-2.5 font-semibold whitespace-nowrap text-zinc-200", align]}>{content}</th>;
        }
        return <td class={["px-4 py-2.5 align-top leading-6 text-zinc-300", align]}>{content}</td>;
      },
    },
  });
  return d.document.blocks[0]?._tag == "Heading" ? [blocks[0], afterTitle, ...blocks.slice(1)] : [afterTitle, ...blocks];
};
