// The documentation's navigation: the list of pages, grouped, for the sidebar and the
// mobile menu, and the outline of the current page.
import { Html } from "@effect/ui/html";
import { docPath, docs, groups } from "../../lib/docs.efs";
import type { Entry } from "../../lib/docs.efs";

const pageLink = (active: boolean): string =>
  `-ml-px block border-l py-1.5 pl-4 text-sm transition ${active ? "border-violet-400 font-medium text-white" : "border-transparent text-zinc-400 hover:border-zinc-500 hover:text-zinc-200"}`;

/** The pages, grouped; `active` is the slug of the current page, or "" on the index. */
export const pageList = <M>(h: Html.H<M>, active: string) =>
  <nav aria-label="Documentation" class="space-y-8">
    <a
      href="/docs"
      class={active == "" ? "block text-sm font-semibold text-white" : "block text-sm font-semibold text-zinc-300 hover:text-white"}
    >
      Overview
    </a>
    {groups.map((group) =>
      <div>
        <h2 class="text-xs font-semibold tracking-wider text-zinc-500 uppercase">{group}</h2>
        <ul class="mt-3 border-l border-white/10">
          {docs.filter((d) => d.group == group).map((d) =>
            <li>
              <a href={docPath(d)} class={pageLink(d.slug == active)} aria-current={d.slug == active ? "page" : undefined}>
                {d.label}
              </a>
            </li>)}
        </ul>
      </div>)}
  </nav>;

/** The sidebar on wide screens. */
export const sidebar = <M>(h: Html.H<M>, active: string) =>
  <aside class="hidden lg:block">
    <div class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto py-10 pr-2">{pageList(h, active)}</div>
  </aside>;

const chevron = <M>(h: Html.H<M>) =>
  <svg viewBox="0 0 16 16" class="h-4 w-4 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>;

/** The menu on narrow screens, closed until opened; `label` names the current page. */
export const mobileMenu = <M>(h: Html.H<M>, active: string, label: string) =>
  <details class="group sticky top-16 z-40 -mx-4 border-b border-white/5 bg-zinc-950/90 backdrop-blur sm:-mx-6 lg:hidden">
    <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm text-zinc-300 sm:px-6 [&::-webkit-details-marker]:hidden">
      <svg viewBox="0 0 16 16" class="h-4 w-4 text-zinc-500" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2.5 4h11M2.5 8h11M2.5 12h11" stroke-linecap="round" />
      </svg>
      <span class="text-zinc-500">Docs</span>
      <span class="text-zinc-600">/</span>
      <span class="truncate font-medium text-white">{label}</span>
      <span class="ml-auto text-zinc-500">{chevron(h)}</span>
    </summary>
    <div class="max-h-[70dvh] overflow-y-auto border-t border-white/5 px-4 py-6 sm:px-6">{pageList(h, active)}</div>
  </details>;

const tocLink = (level: number, active: boolean): string =>
  `block py-1 text-sm leading-5 transition ${level == 3 ? "pl-3" : ""} ${active ? "font-medium text-violet-300" : "text-zinc-400 hover:text-white"}`;

/** "On this page": the page's second and third level headings; `active` is the one being read. */
export const toc = <M>(h: Html.H<M>, entries: Entry[], active: string) =>
  <ul class="space-y-0.5">
    {entries.map((e) =>
      <li>
        <a href={`#${e.id}`} class={tocLink(e.level, e.id == active)} aria-current={e.id == active ? "location" : undefined}>
          {e.text}
        </a>
      </li>)}
  </ul>;
