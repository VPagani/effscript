// The landing page.
import { Html } from "@effect/ui/html";
import { UiSchema } from "@effect/ui";
import { compile, isLoaded, whenLoaded } from "../lib/compiler.efs";
import { codeBlock } from "../lib/code.efs";
import { linkTo } from "../lib/share.efs";
import { githubIcon } from "../lib/icons.efs";
import { gettingStarted, languageGuide, repository, websiteSource } from "../lib/links.efs";
import { exampleById, examples } from "../examples.efs";

const analogies = [
  { from: "async function", to: "effect function", note: "a traced Effect.fn" },
  { from: "await promise", to: "run effect", note: "yield* in the generator" },
  { from: "try / catch", to: "catch { NotFound(e) => … }", note: "typed, by error tag" },
  { from: "dependency injection", to: "use Service … with Layer", note: "services and layers" },
];

const features = [
  {
    title: "Plain Effect output",
    body: "Compiles to the TypeScript you would write by hand: Effect.fn, Context.Service, Data.TaggedError, Match. No runtime and no lock-in.",
  },
  {
    title: "Real types",
    body: "Type checked by tsrs, the Rust port of the TypeScript 7 checker, with errors at EffScript positions. EffScript and TypeScript import each other.",
  },
  {
    title: "The whole ecosystem",
    body: "Services, layers, typed errors, schemas, match and streams, plus effect-machine statecharts and Effect UI components with markup.",
  },
  {
    title: "Tooling included",
    body: "One efs command builds, checks, formats and lints, and runs a language server with hovers and go to definition.",
  },
  {
    title: "Every bundler",
    body: "Plugins for Vite, Rollup, Rolldown, esbuild, Bun and webpack, running the compiler as WebAssembly with source maps.",
  },
  {
    title: "A prelude for Effect",
    body: "Effect, Schema, Layer, Stream and the other core modules are in scope in every file, imported only when used.",
  },
];

const showcase = examples.filter((e) => e.showcase);

const known = "rounded bg-white/10 px-1.5 py-0.5 font-mono text-[0.9em] text-zinc-200";

const keyword = "rounded bg-violet-500/20 px-1.5 py-0.5 font-mono text-[0.9em] text-violet-200";

const panel = "overflow-hidden rounded-xl border border-white/10 bg-[#0d1117] shadow-2xl shadow-black/40";

const panelHeader = "flex items-center gap-2 border-b border-white/10 px-4 py-2.5 text-xs text-zinc-400";

const dots = <M>(h: Html.H<M>) =>
  <span class="mr-2 flex gap-1.5">
    <span class="h-2.5 w-2.5 rounded-full bg-zinc-700" />
    <span class="h-2.5 w-2.5 rounded-full bg-zinc-700" />
    <span class="h-2.5 w-2.5 rounded-full bg-zinc-700" />
  </span>;

export component Home {
  let ready: Boolean = isLoaded();
  let example: String = "errors";

  update LoadedCompiler {
    ready = true;
  }

  update PickedExample(id: String) {
    example = id;
  }

  subscriptions = ({ model }) => model.ready ? [] : [whenLoaded(HomeMessage.LoadedCompiler())];

  view =>
    <div>
      <section class="relative overflow-hidden">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 -top-40 mx-auto h-[36rem] max-w-5xl rounded-full bg-gradient-to-tr from-violet-600/30 via-indigo-500/20 to-sky-400/20 blur-3xl"
        />
        <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 text-center sm:pt-28">
          <p class="mx-auto inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-zinc-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
            Early preview, for Effect 4
          </p>
          <h1 class="mx-auto mt-6 max-w-4xl text-5xl font-extrabold tracking-tight text-white sm:text-7xl">
            Effect, without the<span class="block bg-gradient-to-r from-violet-300 via-indigo-300 to-sky-300 bg-clip-text text-transparent">
              incantations.
            </span>
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-300">
            EffScript is a small language that compiles to the Effect code you would write by hand.
          </p>
          <p class="mx-auto mt-2 max-w-2xl text-lg leading-8 text-zinc-300">If you know <code class={known}>async</code> and <code class={known}>await</code>, you already know <code class={keyword}>effect</code> and <code class={keyword}>run</code>.</p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/playground"
              class="rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-zinc-950 shadow-lg shadow-violet-500/20 transition hover:bg-violet-100"
            >
              Open the playground
            </a>
            <a
              href={gettingStarted}
              class="rounded-lg border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              Get started
            </a>
            <a
              href={repository}
              class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold text-zinc-300 transition hover:text-white"
            >
              {githubIcon(h, "h-4 w-4")}
              GitHub
            </a>
          </div>
        </div>
        <div class="relative mx-auto grid max-w-6xl gap-4 px-6 pb-24 lg:grid-cols-2">
          <div class={panel}>
            <div class={panelHeader}>
              {dots(h)}
              <span class="font-mono text-zinc-300">greet.efs</span>
              <span class="ml-auto rounded bg-violet-500/15 px-2 py-0.5 text-[11px] font-medium text-violet-200">EffScript</span>
            </div>
            <div class="max-h-[30rem] overflow-auto">{codeBlock(h, exampleById("overview").source, "efs")}</div>
          </div>
          <div class={panel}>
            <div class={panelHeader}>
              {dots(h)}
              <span class="font-mono text-zinc-300">greet.ts</span>
              <span class="ml-auto rounded bg-sky-500/15 px-2 py-0.5 text-[11px] font-medium text-sky-200">generated TypeScript</span>
            </div>
            <div class="max-h-[30rem] overflow-auto">
              {ready ? codeBlock(h, compile(exampleById("overview").source).ts, "ts") : <p class="p-5 text-sm text-zinc-500">Compiling…</p>}
            </div>
          </div>
        </div>
      </section>
      <section class="border-y border-white/5 bg-white/[0.02]">
        <div class="mx-auto max-w-6xl px-6 py-20">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">What you already know, for Effect</h2>
          <p class="mt-4 max-w-2xl text-zinc-400">
            EffScript gives a name and a shape to the patterns Effect code repeats, and leaves the rest as the TypeScript you know.
          </p>
          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {analogies.map((a) =>
              <div class="rounded-xl border border-white/10 bg-zinc-900/60 p-5">
                <div class="flex flex-wrap items-center gap-3 font-mono text-sm">
                  <span class="text-zinc-400">{a.from}</span>
                  <span class="text-zinc-600">→</span>
                  <span class="text-sky-200">{a.to}</span>
                </div>
                <p class="mt-2 text-sm text-zinc-500">{a.note}</p>
              </div>)}
          </div>
        </div>
      </section>
      <section class="mx-auto max-w-6xl px-6 py-24">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Every construct, and what it compiles to</h2>
        <p class="mt-4 max-w-2xl text-zinc-400">
          The output below is compiled in your browser by the EffScript compiler, running as WebAssembly.
        </p>
        <div class="mt-8 flex flex-wrap gap-2" role="tablist">
          {showcase.map((e) =>
            <button
              type="button"
              role="tab"
              aria-selected={e.id == example ? "true" : "false"}
              class={[
                "rounded-full px-4 py-1.5 text-sm font-medium transition",
                e.id == example ? "bg-white text-zinc-950" : "bg-white/5 text-zinc-300 hover:bg-white/10",
              ]}
              on:click={PickedExample({ id: e.id })}
            >
              {e.title}
            </button>)}
        </div>
        <div class="mt-6 grid gap-4 lg:grid-cols-2">
          <div class={panel}>
            <div class={panelHeader}>
              <span class="font-mono text-zinc-300">{`${example}.efs`}</span>
              <a href={linkTo(exampleById(example).source)} class="ml-auto text-violet-300 hover:text-violet-200">
                Open in the playground →
              </a>
            </div>
            <div class="max-h-[34rem] overflow-auto">{codeBlock(h, exampleById(example).source, "efs")}</div>
          </div>
          <div class={panel}>
            <div class={panelHeader}>
              <span class="font-mono text-zinc-300">{`${example}.ts`}</span>
            </div>
            <div class="max-h-[34rem] overflow-auto">
              {ready ? codeBlock(h, compile(exampleById(example).source).ts, "ts") : <p class="p-5 text-sm text-zinc-500">Compiling…</p>}
            </div>
          </div>
        </div>
      </section>
      <section class="mx-auto max-w-6xl px-6 pb-24">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) =>
            <div class="rounded-xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-transparent p-6">
              <h3 class="font-semibold text-white">{f.title}</h3>
              <p class="mt-2 text-sm leading-6 text-zinc-400">{f.body}</p>
            </div>)}
        </div>
      </section>
      <section class="mx-auto max-w-6xl px-6 pb-24">
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Errors where you wrote them</h2>
            <p class="mt-4 text-zinc-400">
              efs check type checks your project with tsrs, in process, and maps every TypeScript error back to the EffScript line and column. The language server does the same as you type.
            </p>
            <a href={languageGuide} class="mt-6 inline-block text-sm font-semibold text-violet-300 hover:text-violet-200">
              Read the language guide →
            </a>
          </div>
          <div class={panel}>
            <div class={panelHeader}>
              {dots(h)}
              <span class="font-mono">terminal</span>
            </div>
            <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-6 text-zinc-300">
              <span class="text-zinc-500">$ </span>
              efs check{"\n"}
              <span class="text-zinc-400">src/users.efs:37:30: </span>
              <span class="text-red-400">error</span>
              : Argument of type 'number' is not assignable to parameter of type 'UserId'.{"\n"}
              <span class="text-zinc-500">{" 37 |   const user = run repo.find(42);\n    |                              "}</span>
              <span class="text-red-400">^^</span>
              {"\n"}
              <span class="text-zinc-500">checked 4 EffScript files in 95ms, 1 error</span>
            </pre>
          </div>
        </div>
      </section>
      <section class="mx-auto max-w-6xl px-6 pb-28">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-violet-600/20 via-indigo-600/10 to-sky-500/10 px-8 py-14 text-center">
          <h2 class="text-3xl font-bold tracking-tight text-white">This site is written in EffScript</h2>
          <p class="mx-auto mt-4 max-w-xl text-zinc-300">
            Every page is an Effect UI component written in EffScript, and the playground runs the compiler as WebAssembly.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/playground" class="rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-violet-100">
              Try it now
            </a>
            <a
              href={websiteSource}
              class="rounded-lg border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              Read the source
            </a>
          </div>
        </div>
      </section>
    </div>
}
