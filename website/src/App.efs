// The site's shell: the header, the current page and the footer.
import { Html } from "@effect/ui/html";
import { Router, UiSchema } from "@effect/ui";
import { AppRoute } from "./routes.efs";
import { Home } from "./pages/Home.efs";
import { Playground } from "./pages/Playground.efs";
import { githubIcon, logo } from "./lib/icons.efs";
import { languageGuide, repository } from "./lib/links.efs";

const navLink = (active: boolean): string =>
  `rounded-md px-3 py-1.5 text-sm font-medium transition ${active ? "bg-white/10 text-white" : "text-zinc-400 hover:text-white"}`;

export component App {
  prop route: AppRoute;
  let current: AppRoute = route;

  update ChangedRoute(next: AppRoute) {
    current = next;
  }

  subscriptions = ({ model }) => [Router.subscription(AppRoute, model.current, (next) => ChangedRoute({ next }))];

  view =>
    <div class="flex min-h-dvh flex-col">
      <header class="sticky top-0 z-50 h-16 border-b border-white/5 bg-zinc-950/80 backdrop-blur">
        <div class="mx-auto flex h-full max-w-6xl items-center gap-6 px-6">
          <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-white">
            {logo(h)}
            EffScript
          </a>
          <nav class="flex items-center gap-1">
            <a href="/playground" class={navLink(current._tag == "Playground")}>Playground</a>
            <a href={languageGuide} class={navLink(false)}>Docs</a>
          </nav>
          <a href={repository} class="ml-auto text-zinc-400 transition hover:text-white" aria-label="GitHub">
            {githubIcon(h, "h-5 w-5")}
          </a>
        </div>
      </header>
      <main class="flex-1">
        {AppRoute.match(current, {
          Home: () => <Home key="home" />,
          Playground: () => <Playground key="playground" />,
          NotFound: () =>
            <section class="mx-auto max-w-xl px-6 py-32 text-center">
              <p class="font-mono text-sm text-violet-300">404</p>
              <h1 class="mt-3 text-4xl font-bold text-white">Page not found</h1>
              <a href="/" class="mt-8 inline-block text-sm font-semibold text-violet-300 hover:text-violet-200">
                Back to the home page →
              </a>
            </section>,
        })}
      </main>
      {current._tag == "Playground" ? null : <footer class="border-t border-white/5">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-4 px-6 py-8 text-sm text-zinc-500">
          <span>MIT licensed</span>
          <span>Built with EffScript, Effect UI and Tailwind CSS</span>
          <a href={repository} class="ml-auto hover:text-zinc-300">GitHub</a>
        </div>
      </footer>}
    </div>
}
